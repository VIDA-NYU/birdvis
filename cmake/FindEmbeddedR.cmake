find_program(R_EXECUTABLE NAMES R REQUIRED)
# Preserve the configure-time package library for automatic CMake regeneration.
set(BIRDVIS_R_LIBS_USER "$ENV{R_LIBS_USER}" CACHE STRING "R user library used for dependency discovery")
function(r_query output)
    set(r_command "${R_EXECUTABLE}")
    if(BIRDVIS_R_LIBS_USER)
        set(r_command "${CMAKE_COMMAND}" -E env "R_LIBS_USER=${BIRDVIS_R_LIBS_USER}" "${R_EXECUTABLE}")
    endif()
    execute_process(COMMAND ${r_command} ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE value ERROR_VARIABLE error
        OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "R configuration failed: ${error}\nInstall Rcpp and RInside into the selected R's library.")
    endif()
    set(${output} "${value}" PARENT_SCOPE)
endfunction()
r_query(R_HOME RHOME)
r_query(R_CPPFLAGS CMD config --cppflags)
r_query(R_LDFLAGS CMD config --ldflags)
r_query(RCPP_INCLUDE --vanilla --slave -e "cat(system.file('include', package='Rcpp', mustWork=TRUE))")
r_query(RINSIDE_INCLUDE --vanilla --slave -e "cat(system.file('include', package='RInside', mustWork=TRUE))")
r_query(R_PACKAGE_LDFLAGS --vanilla --slave -e "cat(RInside:::LdFlags())")
separate_arguments(R_COMPILE_FLAGS UNIX_COMMAND "${R_CPPFLAGS}")
separate_arguments(R_LINK_FLAGS UNIX_COMMAND "${R_PACKAGE_LDFLAGS} ${R_LDFLAGS}")
add_library(EmbeddedR INTERFACE)
target_include_directories(EmbeddedR INTERFACE "${RCPP_INCLUDE}" "${RINSIDE_INCLUDE}")
target_compile_options(EmbeddedR INTERFACE ${R_COMPILE_FLAGS})
target_link_libraries(EmbeddedR INTERFACE ${R_LINK_FLAGS})
message(STATUS "Embedded R: ${R_EXECUTABLE} (${R_HOME})")

r_query(R_PACKAGE_LIBRARIES --vanilla --slave -e "cat(paste(unique(dirname(c(find.package('Rcpp'), find.package('RInside')))), collapse=.Platform$path.sep))")
